# Environment configuration for PrismCare
# Copy this file to .env and fill in your own values. Never commit .env.

# Gemini API key (free: https://aistudio.google.com/app/apikey)
# Used by the lab analyzer and XAI-RAG engine
GEMINI_API_KEY=your_gemini_api_key_here

# OpenRouter API key (https://openrouter.ai/keys)
# Used for AI patient summaries; without it a rule-based fallback is used
OPENROUTER_API_KEY=your_openrouter_api_key_here

# Enable/disable LLM features (true/false)
USE_LLM=true

# LLM model name
LLM_MODEL=gemini-2.0-flash-exp
